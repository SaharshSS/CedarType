<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CedarType</AssemblyName>
    <RootNamespace>CedarType.Windows</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\LanguageProfiles.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
